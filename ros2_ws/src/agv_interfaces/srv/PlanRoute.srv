# Empty request_id generates a UUID. Reuse of an accepted ID is rejected.
string run_id
string request_id
uint8 stage
# 0 resolves to the planner's current node (start) or YAML start_area (goal).
int32 start
int32 goal
# Explicit current map heading for synchronization; required with explicit start.
# Empty with start=0 derives heading from continuous odometry yaw.
string current_heading
# Only the destination may receive work rotations; intermediate stations never do.
bool align_at_goal
# Empty uses YAML work_heading.node_<goal> when align_at_goal=true.
# Must be empty when align_at_goal=false.
string goal_heading
# Empty: normal topology route. EXIT / ENTER: diagonal at start=goal (node 1 or 3).
# EXIT may run before the startup map snapshot. Heading stays unchanged.
string parking_maneuver
# Displacement along EACH body axis, in mm; used only for parking maneuvers.
uint32 parking_offset_mm
---
# The same plan is also published once on /route/path, including failed requests.
agv_interfaces/RoutePlan plan
